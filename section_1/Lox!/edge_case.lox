// Causes an issue! Works like C, not python.

// How do functions handle variables that aren't global but are still "in scope"?
fun scope_test1(){
  var a = 1;
  fun scope_test2(){
    a = a-1;
  }
  scope_test2();
  print a;
}

scope_test1();
// Again, works

// Okay now for the proper test, I defined x globally earlier
// What if I define x again as a local variable inside a function
// And *then* call global?
print x;
fun scope_fuckery(){
  var x = 12;
  global(1);
  print x;
}
scope_fuckery();
print x;
// Changes the global x and not the x inside the function!

// Can I do the same thing for functions? What if I define a function globally
// Define function with same name inside a function
// Then call a function referencing that function
fun func_that_will_be_local_too(hi){
  return hi+4;
}

fun global_func_test(hi){
  return func_that_will_be_local_too(hi);
}

fun other_func(hi){
  fun func_that_will_be_local_too(hi){ // This never gets called
    return hi-9;
  }
  return global_func_test(hi);
}

print other_func(7);

// Are classes copied like other variables, or are they passed by reference (like python)?
class how_are_classes_handled {
  init (ahhhh){
    this.ahhhh = 5;
  }

  method_func_clash(){print "method!";}
}

var instance = how_are_classes_handled(1);
copy_reference_test(instance.ahhhh); // This is probably copied
print instance.ahhhh;

fun copy_reference_test_2(inst){
  inst.ahhhh = inst.ahhhh -1;
}

copy_reference_test_2(instance); // this might be passed by reference
print instance.ahhhh;
// IT IS, AGH
// be consistent
// this is why I hate python it copies numbers but not lists
// pick a default and let the user explicitly say when they don't want to use that default
// like in C++ with x& to pass by reference but the default being to copy everything

// What if I name a class method the same as a function?
fun method_func_clash(){
  print "function!";
}

method_func_clash();
instance.method_func_clash();
// Okay they don't clash, I think that's sensible

