// What do weird expressions evaluate to truth-wise? What is the truth value of "5" or "var x = 3"?
if (5){
  print "hi";
}
if (-5){
  print "hi";
}
if (0){
  print "hi";
}
// Zero evaluates to true, omg ugh.

// if (var x = 3){
// print "hi";
// }
// Doesn't evaluate to anything, gives error. Interesting. C would treat this as true.

if ("hi"){
  print "hello";
}
// strings always evaluate to true

// Do functions make copies of variables? (like in C/C++) 
// or reference them? (like pass by reference in C++, or by default for lists in python)
fun copy_reference_test(z){
  z = z-1;
}

var x = 5;
copy_reference_test(x);
print x;
// It copies them, doesn't appear to be a way to pass by reference

// How do functions handle global variables?
fun global(y){
  x = x-1;
}
global(1);
print x;
// No issue, changes them as expected

